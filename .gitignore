# Ignore all .env files anywhere
**/.env

# Caddy (ignore only inside caddy-reverse-proxy)
caddy-reverse-proxy/caddy_data/
caddy-reverse-proxy/caddy_config/
caddy-reverse-proxy/site/

# Immich
immich/library/
immich/postgres/

# Jellifyn
jellifyn/cache/
jellifyn/config/

#Adguard
adguardhome/config/*
adguardhome/work/*

# Project-x
project-x/*

# arr-stack: only docker-compose.yml is versioned.
# App data dirs hold SQLite DBs, logs and API keys (config.xml, settings.json, qBittorrent.conf)
arr-stack/*/

# Homepage (config/*.yaml is versioned)
homepage/config/logs/

# Generic
*.bak
*.bak.*
*.log
*.pid
*.db-shm
*.db-wal
